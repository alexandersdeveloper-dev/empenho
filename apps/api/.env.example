# ── Supabase ──────────────────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL do frontend no Vercel. Para múltiplas origens, separe por vírgula:
# FRONTEND_URL=https://seu-app.vercel.app,https://outro-dominio.com.br
FRONTEND_URL=https://seu-app.vercel.app
